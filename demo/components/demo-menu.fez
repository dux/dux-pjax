<info>
  <ul>
    <li>Top navigation for the dux-pjax demo</li>
    <li>Plain anchors so <code>Pjax.onDocumentClick()</code> hijacks them</li>
    <li>Hrefs are absolute paths prefixed with <code>window.DEMO_ROOT</code> (set by demo-head.js) so the demo works at <code>/</code> and at <code>/&lt;repo&gt;/</code> on GitHub Pages</li>
    <li>Active state compares normalised pathnames (treats <code>foo/</code> and <code>foo/index.html</code> as equal)</li>
  </ul>
</info>

<script>
  // demo-head.js computes the deployment root and stashes it on window.
  // Fall back to '/' if a stray page loads without demo-head.js.
  const ROOT = (typeof window !== 'undefined' && window.DEMO_ROOT) || '/'

  const PAGES = [
    { sub: '',                 label: 'Home' },
    { sub: 'demo/load',        label: 'Load' },
    { sub: 'demo/refresh',     label: 'Refresh' },
    { sub: 'demo/targeted',    label: 'Targeted' },
    { sub: 'demo/forms',       label: 'Forms' },
    { sub: 'demo/scripts',     label: 'Scripts' },
    { sub: 'demo/preserve',    label: 'Preserve' },
    { sub: 'demo/lifecycle',   label: 'Lifecycle' },
    { sub: 'demo/confirm',     label: 'Confirm' },
    { sub: 'demo/qs',          label: 'Query string' },
    { sub: 'demo/transitions', label: 'Transitions' },
    { sub: 'demo/fez',         label: 'Fez' },
  ].map((p) => ({ ...p, path: ROOT + p.sub }))

  // Normalise so '/foo', '/foo/', '/foo.html', '/foo/index.html' compare equal.
  const norm = (path) =>
    path.replace(/[?#].*$/, '')
        .replace(/\/index\.html$/, '/')
        .replace(/\.html$/, '')
        .replace(/\/$/, '')

  class {
    init() {
      this.LINKS = PAGES
    }

    onMount() {
      this.on('pjax:render', () => this.refresh())
    }

    isActive(link) {
      return norm(location.pathname) === norm(link.path)
    }
  }
</script>

<style>
  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;

    a {
      color: #cbd5e1;
      text-decoration: none;
      font-weight: 500;
      padding: 0 0.75rem;
      border-radius: 6px;
      font-size: 0.85rem;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      height: 1.85rem;
      transition: background 0.12s ease, color 0.12s ease;

      &:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #f8fafc;
      }

      &.active {
        background: #2563eb;
        color: #fff;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.15) inset;
      }

      &.gh {
        margin-left: 0.5rem;
        padding: 0;
        width: 1.85rem;
        justify-content: center;

        svg {
          width: 24px;
          height: 24px;
          fill: currentColor;
          display: block;
        }
      }
    }
  }
</style>

<nav>
  {#each LINKS as link}
    <a href={link.path} class:active={isActive(link)}>{link.label}</a>
  {/each}
  <a class="gh" href="https://github.com/dux/dux-pjax" target="_blank" rel="noopener" aria-label="dux-pjax on GitHub" title="dux-pjax on GitHub">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
    </svg>
  </a>
</nav>

